# 공개 클라이언트에는 publishable key만 넣습니다. secret/service_role 키를 작성하지 마세요.
PUBLIC_CMS_ENABLED=false
# 일정 마이그레이션 검증·적용 후 true로 설정합니다.
PUBLIC_SCHEDULE_ENABLED=false
# 분리된 테스트 배포에서 Owner 아이디 로그인·복구를 확인한 뒤에만 활성화합니다.
PUBLIC_STAFF_IDENTITY_ENABLED=false
# 전환 중 기존 이메일 링크를 별도 도움말에서만 제공할 때 true로 설정합니다.
PUBLIC_STAFF_LEGACY_LOGIN_ENABLED=false
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
