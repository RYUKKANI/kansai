{
  "name": "kansai-united-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-build.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "export:preview": "node scripts/export-preview.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:auth:native": "node scripts/test-native-auth.mjs",
    "test:parts": "node scripts/run-tests.mjs --list",
    "test:plan": "node scripts/plan-checks.mjs",
    "test:prepare": "node scripts/prepare-test-fixtures.mjs",
    "test:dashboard": "node scripts/prepare-test-fixtures.mjs --part dashboard --run",
    "test:auth": "node scripts/prepare-test-fixtures.mjs --part auth --run",
    "test:members": "node scripts/prepare-test-fixtures.mjs --part members --run",
    "test:content": "node scripts/prepare-test-fixtures.mjs --part content --run",
    "test:players": "node scripts/prepare-test-fixtures.mjs --part players --run",
    "test:schedule": "node scripts/prepare-test-fixtures.mjs --part schedule --run",
    "test:media": "node scripts/prepare-test-fixtures.mjs --part media --run",
    "test:public": "node scripts/prepare-test-fixtures.mjs --part public --run",
    "test:security": "node scripts/prepare-test-fixtures.mjs --part security --run",
    "test:tooling": "node scripts/prepare-test-fixtures.mjs --part tooling --run",
    "test:full": "node scripts/prepare-test-fixtures.mjs --all --run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@12.2.0"
}
