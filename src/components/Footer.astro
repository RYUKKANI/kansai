---
import Icon from './Icon.astro';
import { club } from '../data/club';
import { asset, page } from '../lib/urls';
---
<footer class="site-footer">
  <div class="shell footer-top">
    <a href={page()} class="footer-brand"><img src={asset(club.logo)} width="76" height="76" alt="関西ユナイテッドFC ロゴ" /><span>KANSAI<br />UNITED FC.</span></a>
    <div class="footer-links"><a href={page('news/')}>ニュース</a><a href={page('#matches')}>試合情報</a><a href={page('#team')}>選手・スタッフ</a><a href={page('#media')}>メディア</a><a href={page('#club')}>クラブについて</a><a href={page('#join')}>参加・お問い合わせ</a></div>
    <a href={club.instagram} class="social-button" target="_blank" rel="noopener noreferrer" aria-label="公式Instagramを開く"><Icon name="instagram" size={24} /></a>
  </div>
  <div class="shell footer-bottom"><span>© {new Date().getFullYear()} KANSAI UNITED FC. <span class="footer-preview">Design preview.</span></span><span>写真：公式Instagram @kansai_united_fc</span><a href="#top">PAGE TOP ↑</a></div>
</footer>
