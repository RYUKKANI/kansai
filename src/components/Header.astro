---
import Icon from './Icon.astro';
import { club } from '../data/club';
import { asset, page } from '../lib/urls';
const navigation = [
  { label: 'ニュース', english: 'NEWS', href: page('news/') },
  { label: '試合情報', english: 'MATCHES', href: page('#matches') },
  { label: '選手・スタッフ', english: 'TEAM', href: page('#team') },
  { label: 'メディア', english: 'MEDIA', href: page('#media') },
  { label: 'クラブ', english: 'CLUB', href: page('#club') },
];
---
<div class="preview-strip"><div class="shell flex items-center justify-between gap-3"><span><span class="status-dot"></span> DESIGN PREVIEW <span class="preview-description">／ デザイン確認用</span></span><a href={club.instagram} target="_blank" rel="noopener noreferrer">公式Instagram <Icon name="external" size={12} /></a></div></div>
<header class="site-header" id="top">
  <div class="shell header-inner">
    <a href={page()} class="brand" aria-label="関西ユナイテッドFC トップページ">
      <img src={asset(club.logo)} width="60" height="60" alt="関西ユナイテッドFC ロゴ" />
      <span class="brand-words"><strong>KANSAI<br />UNITED <span>FC</span></strong><small>関西ユナイテッドFC</small></span>
    </a>
    <nav class="desktop-navigation" aria-label="メインナビゲーション">
      {navigation.map(item => <a href={item.href} class:list={[{ active: Astro.url.pathname.includes('/news') && item.english === 'NEWS' }]}><span>{item.label}</span><small>{item.english}</small></a>)}
    </nav>
    <div class="header-actions">
      <button type="button" class="icon-button search-open" aria-label="ニュースを検索"><Icon name="search" /></button>
      <a class="join-nav" href={page('#join')}>チームに参加 <Icon name="arrow" size={17} /></a>
      <button type="button" class="icon-button mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-navigation" aria-label="メニューを開く"><Icon name="menu" /><Icon name="close" class="menu-close-icon" /></button>
    </div>
  </div>
  <nav class="mobile-navigation" id="mobile-navigation" aria-label="モバイルナビゲーション" hidden>
    {navigation.map(item => <a href={item.href}><span>{item.label}</span><small>{item.english}</small><Icon name="arrow" /></a>)}
    <a href={page('#join')}><span>チームに参加</span><small>JOIN US</small><Icon name="arrow" /></a>
  </nav>
</header>
