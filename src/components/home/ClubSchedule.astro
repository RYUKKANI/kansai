---
import { loadPublicContent } from "../../data/cms";
import { dateLabel } from "../../lib/admin-ui";
// 공개 전용 읽기 모델에는 내부 운영 메모가 포함되지 않습니다.
const enabled = import.meta.env.PUBLIC_SCHEDULE_ENABLED === "true";
const { schedules } = await loadPublicContent();
const labels = {
  fixtures: "試合",
  training_sessions: "練習",
  club_events: "クラブ行事",
};
const states: Record<string, string> = {
  scheduled: "開催予定",
  completed: "終了",
  cancelled: "中止",
  postponed: "延期",
};
const upcoming = schedules
  .filter((item) => item.starts_at && new Date(item.starts_at) >= new Date())
  .slice(0, 6);
---

{enabled && (
  <section class="shell club-schedule" aria-labelledby="club-schedule-title">
    <p class="eyebrow">CLUB SCHEDULE</p>
    <h2 id="club-schedule-title" class="display">
      これからの予定
    </h2>
    <p>日時は日本時間（JST）です。</p>
    {upcoming.length ? (
      <div class="schedule-cards">
        {upcoming.map((item) => (
          <article>
            <p>
              {labels[item.resource]} ·{" "}
              {states[item.schedule_status] ?? item.schedule_status}
            </p>
            <h3>{item.title}</h3>
            <p>{dateLabel(item.starts_at, true)}</p>
            <p>{item.venue || "場所未定"}</p>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>公開する予定は、決まり次第お知らせします。</p>
    )}
  </section>
)}
<style>
  .club-schedule {
    padding-block: 40px;
  }
  .club-schedule h2 {
    font-size: 32px;
  }
  .schedule-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .schedule-cards article {
    background: white;
    border: 1px solid #e1e8f0;
    padding: 24px;
    border-top: 3px solid #1168bc;
  }
  .schedule-cards h3 {
    font-size: 20px;
  }
  .schedule-cards p {
    line-height: 1.8;
    white-space: pre-line;
  }
  @media (max-width: 700px) {
    .schedule-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
