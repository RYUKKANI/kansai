---
import Icon from "../Icon.astro";
import FixtureCard from "../FixtureCard.astro";
import { loadPublicContent } from "../../data/cms";
import { page } from "../../lib/urls";
// [편집 안내] 확인된 공개 일정·결과만 연결합니다. 날짜가 없는 일정도 발표 상태를 그대로 표시합니다.
const { fixtures } = await loadPublicContent();
const next = fixtures.find(
  (f) =>
    f.status === "scheduled" &&
    (!f.kickoff || new Date(f.kickoff).getTime() >= Date.now()),
);
const result = [...fixtures].reverse().find((f) => f.status === "completed");
---

<section
  class="shell match-section section-anchor"
  id="matches"
  aria-labelledby="match-title"
  data-tabs
>
  <div class="match-heading">
    <p class="eyebrow">試合情報</p>
    <h2 id="match-title" class="display">
      MATCH
      <br />
      CENTRE<span class="text-blue">.</span>
    </h2>
    <div class="match-tabs" role="tablist" aria-label="試合情報の表示">
      <button
        type="button"
        role="tab"
        id="next-tab"
        aria-selected="true"
        aria-controls="next-panel"
        tabindex="0"
      >
        次の試合
      </button>
      <button
        type="button"
        role="tab"
        id="result-tab"
        aria-selected="false"
        aria-controls="result-panel"
        tabindex="-1"
      >
        試合結果
      </button>
    </div>
    <a class="text-link match-all-link" href={page("matches/")}>
      日程・結果一覧 <Icon name="arrow" size={18} />
    </a>
  </div>
  <div id="next-panel" role="tabpanel" aria-labelledby="next-tab">
    {next ? (
      <FixtureCard fixture={next} />
    ) : (
      <div class="fixture-card fixture-unannounced">
        <p class="eyebrow">
          NEXT MATCH <span class="pending-tag">発表前</span>
        </p>
        <Icon name="ball" size={40} />
        <h3>次の試合は、正式発表をお待ちください。</h3>
        <p>対戦相手・大会・日時・会場は、確認された情報を掲載します。</p>
      </div>
    )}
  </div>
  <div id="result-panel" role="tabpanel" aria-labelledby="result-tab" hidden>
    {result ? (
      <FixtureCard fixture={result} />
    ) : (
      <div class="fixture-card fixture-unannounced">
        <p class="eyebrow">LATEST RESULT</p>
        <Icon name="ball" size={40} />
        <h3>試合結果は、公開をお待ちください。</h3>
        <p>公式の試合結果が確認でき次第、こちらに掲載します。</p>
      </div>
    )}
  </div>
</section>
