---
import Icon from "../Icon.astro";
import MatchSummaryCard from "../MatchSummaryCard.astro";
import { loadPublicContent } from "../../data/cms";
import { page } from "../../lib/urls";
import { selectMatchCentre } from "../../lib/match-centre";
// [편집 안내] 왼쪽 제목과 오른쪽 경기 카드 3개로 구성합니다. 미정 문구는 공통 카드에서 편집합니다.
const { fixtures } = await loadPublicContent();
const { last, next, upcoming } = selectMatchCentre(fixtures);
---

<section
  class="shell match-section section-anchor"
  id="matches"
  aria-labelledby="match-title"
>
  <div class="match-heading">
    <p class="eyebrow">試合情報</p>
    <h2 id="match-title" class="display">
      MATCH
      <br />
      CENTRE<span class="text-blue">.</span>
    </h2>
    <p class="match-intro">
      直近の結果と
      <br />
      これからの試合
    </p>
    <a class="text-link match-all-link" href={page("matches/")}>
      日程・結果一覧 <Icon name="arrow" size={18} />
    </a>
  </div>
  <div class="match-cards" aria-label="直近の結果と今後の試合">
    <MatchSummaryCard
      kind="last"
      title="Last Match"
      japanese="直近の試合"
      fixture={last}
    />
    <MatchSummaryCard
      kind="next"
      title="Next Match"
      japanese="次の試合"
      fixture={next}
    />
    <MatchSummaryCard
      kind="upcoming"
      title="Upcoming Match"
      japanese="その次の試合"
      fixture={upcoming}
    />
  </div>
</section>
