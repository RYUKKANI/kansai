---
import Icon from "../Icon.astro";
import NewsCard from "../NewsCard.astro";
import NewsFilters from "../NewsFilters.astro";
import { loadPublicContent } from "../../data/cms";
import { page } from "../../lib/urls";

// 홈 뉴스와 목록 페이지가 같은 카드·필터를 사용합니다. 홈 전용 사진은 데이터에서 지정합니다.
const { stories: allStories } = await loadPublicContent();
const stories = allStories.slice(0, 6);
---

<section
  class="shell news-section section-anchor"
  id="news"
  aria-labelledby="news-title"
  data-filter-group
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">ニュース & ストーリー</p>
      <h2 id="news-title" class="display">
        LATEST NEWS<span class="text-blue">.</span>
      </h2>
    </div>
    <a class="text-link" href={page("news/")}>
      すべてのニュース <Icon name="arrow" />
    </a>
  </div>
  <NewsFilters total={stories.length} />
  <div class="news-grid">
    {stories.map((story) => (
      <NewsCard story={story} image={story.homeCardImage ?? story.image} />
    ))}
  </div>
  {stories.length === 0 && (
    <p class="content-empty">ニュースは、公開をお待ちください。</p>
  )}
</section>
