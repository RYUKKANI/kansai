---
import { loadPublicContent } from "../../data/cms";
import { positions } from "../../lib/content-types";
import { page } from "../../lib/urls";
import PlayerCard from "../PlayerCard.astro";
import Icon from "../Icon.astro";
// [편집 안내] 공개 승인을 받은 활동 선수만 홈에 표시합니다. 미등록 포지션은 안내 카드로 남깁니다.
const { players } = await loadPublicContent();
const featured = players
  .filter((p) => p.activityStatus === "active")
  .slice(0, 4);
---

<section
  class="team-section section-anchor"
  id="team"
  aria-labelledby="team-title"
>
  <div class="shell squad-home">
    <div class="team-copy">
      <p class="eyebrow">選手・スタッフ</p>
      <h2 id="team-title" class="display">
        OUR SQUAD<span>.</span>
      </h2>
      <p>ピッチでプレーする人。チームを支える人。</p>
      <a class="squad-all-link" href={page("team/")}>
        選手プロフィールを見る <Icon name="arrow" size={20} />
      </a>
    </div>
    {featured.length ? (
      <div class="squad-grid">
        {featured.map((player) => (
          <PlayerCard player={player} />
        ))}
      </div>
    ) : (
      <div class="position-preview-grid">
        {positions.map((position) => (
          <a class="position-preview" href={page("team/#" + position.id)}>
            <span class="display">{position.id}</span>
            <strong>{position.english}</strong>
            <small>プロフィール掲載準備中</small>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    )}
  </div>
</section>
