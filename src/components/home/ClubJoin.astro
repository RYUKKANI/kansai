---
import Icon from "../Icon.astro";
import { club } from "../../data/club";
import { loadPublicContent } from "../../data/cms";
import { asset, page } from "../../lib/urls";
const { pages } = await loadPublicContent();
const about = pages.find((p) => p.id === "club");
const join = pages.find((p) => p.id === "join");
---

<section
  class="shell club-join-section section-anchor"
  aria-label="クラブ紹介と参加について"
>
  <div class="club-panel section-anchor" id="club">
    <p class="eyebrow">クラブについて</p>
    <h2 class="display">
      THIS IS
      <br />
      KANSAI UNITED<span class="text-blue">.</span>
    </h2>
    <div class="club-intro">
      <img src={asset(club.logo)} alt="" width="70" height="70" />
      <div>
        <h3>{about?.title ?? club.name}</h3>
        <p>{about?.introduction ?? "クラブ情報は、公開準備中です。"}</p>
      </div>
    </div>
    <a class="text-link" href={page("club/")}>
      クラブについてもっと知る <Icon name="arrow" size={18} />
    </a>
  </div>
  <div class="join-panel section-anchor" id="join">
    <span class="join-decoration" aria-hidden="true">
      +
    </span>
    <p class="eyebrow">JOIN THE TEAM</p>
    <h2>{join?.title ?? "参加について"}</h2>
    <p class="join-roles">
      PLAYER <span>/</span> COACH <span>/</span> STAFF
    </p>
    <p class="join-body">
      {join?.introduction ?? "お問い合わせは公式InstagramのDMへ。"}
    </p>
    <a class="join-button" href={page("join/")}>
      参加・見学のご案内 <Icon name="arrow" size={20} />
    </a>
    <a
      class="join-instagram"
      href={club.instagram}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="instagram" size={18} /> 公式Instagramで相談する
    </a>
  </div>
</section>
