---
import { forLocale, localeFromUrl, localizedPage } from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
const page = (path = "") => localizedPage(path, locale);
import Icon from "../Icon.astro";
import Photo from "../Photo.astro";
import { storyCategories } from "../../data/club";
import { loadPublicContent } from "../../data/cms";

// 관리자에서 추천한 기사를 우선하고, 없으면 최신 기사를 대표 기사로 사용합니다.
const { stories } = await loadPublicContent(locale);
const feature = stories.find((story) => story.featured) ?? stories[0];
const primary = feature
  ? { titleLines: [feature.title], summaryLines: [feature.summary] }
  : null;
const secondary = stories
  .filter((story) => story !== feature)
  .slice(0, 2)
  .map((story) => ({ story, titleLines: [story.title] }));
---

{feature && primary ? (
  <section class="shell lead-grid" aria-label={t("注目のニュース")}>
    <a class="lead-story lead-primary" href={page(`news/${feature.id}/`)}>
      <Photo src={feature.image} alt={feature.alt} priority />
      <div class="story-shade"></div>
      <span class="pick-up">
        <span class="status-dot"></span> PICK UP
      </span>
      <span class="photo-count">
        <Icon name="photo" size={15} />
        {String(feature.gallery.length).padStart(2, "0")}{" "}
        {feature.gallery.length === 1 ? "PHOTO" : "PHOTOS"}
      </span>
      <div class="lead-content">
        <p class="story-meta">
          <span>{t(storyCategories[feature.category].badge)}</span>
          <time datetime={feature.published.replaceAll(".", "-")}>
            {feature.published}
          </time>
        </p>
        <h2>
          {primary.titleLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </h2>
        <p class="lead-summary">
          {primary.summaryLines.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
        <span class="read-story">
          {t("READ THE STORY")}{" "}
          <span class="round-arrow">
            <Icon name="arrow" size={23} />
          </span>
        </span>
      </div>
    </a>

    <div class="secondary-stories">
      {secondary.map(({ story, titleLines }) => (
        <a class="lead-story lead-secondary" href={page(`news/${story.id}/`)}>
          <!-- 보조 사진은 즉시 읽되 대표 사진과 높은 로딩 우선순위를 경쟁하지 않습니다. -->
          <Photo src={story.image} alt={story.alt} eager />
          <div class="story-shade"></div>
          <div class="lead-content">
            <p class="story-meta">
              <span>{t(storyCategories[story.category].badge)}</span>
              <time datetime={story.published.replaceAll(".", "-")}>
                {story.published}
              </time>
            </p>
            <h2>
              {titleLines.map((line, index) => (
                <>
                  {index > 0 && <br />}
                  {line}
                </>
              ))}
            </h2>
            <span class="secondary-arrow">
              <Icon name="arrow" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
) : (
  <section class="shell content-empty">
    <p class="eyebrow">UNITED TODAY</p>
    <h2>{t("ニュースは、公開をお待ちください。")}</h2>
  </section>
)}
