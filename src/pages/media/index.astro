---
import { forLocale, localeFromUrl } from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
import { clubForLocale } from "../../data/locales/content";
const club = clubForLocale(locale);
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import MediaGrid from "../../components/MediaGrid.astro";
import { loadPublicContent } from "../../data/cms";

const { media, albums } = await loadPublicContent(locale);
const ungrouped = media.filter((m) => m.kind === "photo" && !m.albumId);
const videos = media.filter((m) => m.kind === "video");
---

<SiteLayout title={t("写真・動画 | ") + club.name}>
  <PageHero
    title="UNITED MEDIA"
    japanese={t("写真・動画")}
    description={t(
      "クラブの活動を写真と動画でご紹介します。",
    )}
  />
  <div class="shell subpage-content" data-tabs>
    <div class="media-tabs" role="tablist" aria-label={t("メディアの種類")}>
      <button
        type="button"
        id="albums-tab"
        role="tab"
        aria-controls="albums-panel"
        aria-selected="true"
        tabindex="0"
      >
        {t("写真")}
      </button>
      <button
        type="button"
        id="movies-tab"
        role="tab"
        aria-controls="movies-panel"
        aria-selected="false"
        tabindex="-1"
      >
        {t("動画")}
      </button>
    </div>
    <div id="albums-panel" role="tabpanel" aria-labelledby="albums-tab">
      {albums.map((album) => (
        <section class="album-section">
          <p class="eyebrow">{album.capturedOn ?? "PHOTO ALBUM"}</p>
          <h2>{album.title}</h2>
          <p>{album.description}</p>
          <MediaGrid
            items={media.filter(
              (m) => m.kind === "photo" && m.albumId === album.id,
            )}
          />
        </section>
      ))}
      {ungrouped.length > 0 && (
        <section class="album-section">
          <h2 class="display subsection-title">
            ON THE PITCH<span class="text-blue">.</span>
          </h2>
          <MediaGrid items={ungrouped} />
        </section>
      )}
      {!albums.length && !ungrouped.length && (
        <p class="content-empty">{t("現在、公開中の写真はありません。")}</p>
      )}
    </div>
    <div id="movies-panel" role="tabpanel" aria-labelledby="movies-tab" hidden>
      <h2 class="display subsection-title">
        UNITED VIDEO<span class="text-blue">.</span>
      </h2>
      {videos.length ? (
        <MediaGrid items={videos} />
      ) : (
        <p class="content-empty">{t("現在、公開中の動画はありません。")}</p>
      )}
    </div>
  </div>
</SiteLayout>
