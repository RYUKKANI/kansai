---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { club, gallery, stories } from '../data/club';
import { asset, page } from '../lib/urls';
const [feature, second, recruitment] = stories;
---
<SiteLayout>
  <section class="shell home-intro" aria-labelledby="home-title">
    <div><p class="eyebrow"><span class="blue-dash"></span> KANSAI UNITED FC</p><h1 id="home-title" class="display">UNITED TODAY<span class="text-blue">.</span></h1></div>
    <p class="intro-caption">ニュース、活動の様子、クラブ情報。<br /><span>関西ユナイテッドFCの今をお届けします。</span></p>
  </section>

  <section class="shell lead-grid" aria-label="注目のニュース">
    <a class="lead-story lead-primary" href={page(`news/${feature!.id}/`)}>
      <Photo src={feature!.image} alt={feature!.alt} eager />
      <div class="story-shade"></div>
      <span class="pick-up"><span class="status-dot"></span> PICK UP</span>
      <span class="photo-count"><Icon name="photo" size={15} /> 02 PHOTOS</span>
      <div class="lead-content">
        <p class="story-meta"><span>TRAINING</span><time datetime="2026-10-09">2026.10.09</time></p>
        <h2>ゴールを目指す、<br />攻撃のトレーニング。</h2>
        <p class="lead-summary">10月3日、青空のピッチで。<br />動き出しからフィニッシュまでを意識した練習。</p>
        <span class="read-story">READ THE STORY <span class="round-arrow"><Icon name="arrow" size={23} /></span></span>
      </div>
    </a>
    <div class="secondary-stories">
      <a class="lead-story lead-secondary" href={page(`news/${second!.id}/`)}>
        <Photo src={second!.image} alt={second!.alt} eager />
        <div class="story-shade"></div>
        <div class="lead-content"><p class="story-meta"><span>TRAINING</span><time datetime="2026-10-01">2026.10.01</time></p><h2>雨のピッチで、<br />守備を磨く。</h2><span class="secondary-arrow"><Icon name="arrow" /></span></div>
      </a>
      <a class="lead-story lead-secondary" href={page(`news/${recruitment!.id}/`)}>
        <Photo src={recruitment!.image} alt={recruitment!.alt} eager />
        <div class="story-shade"></div>
        <div class="lead-content"><p class="story-meta"><span>CLUB</span><time datetime="2026-10-09">2026.10.09</time></p><h2>選手として。支える側として。<br />チームへの参加について。</h2><span class="secondary-arrow"><Icon name="arrow" /></span></div>
      </a>
    </div>
  </section>

  <section class="shell match-section section-anchor" id="matches" aria-labelledby="match-title" data-tabs>
    <div class="match-heading"><p class="eyebrow">試合情報</p><h2 id="match-title" class="display">MATCH<br />CENTRE<span class="text-blue">.</span></h2><div class="match-tabs" role="tablist" aria-label="試合情報の表示"><button type="button" role="tab" id="next-tab" aria-selected="true" aria-controls="next-panel" tabindex="0">次の試合</button><button type="button" role="tab" id="result-tab" aria-selected="false" aria-controls="result-panel" tabindex="-1">試合結果</button></div></div>
    <div class="match-panel" id="next-panel" role="tabpanel" aria-labelledby="next-tab">
      <div class="match-panel-top"><span class="eyebrow">NEXT MATCH</span><span class="pending-tag">発表前</span></div>
      <div class="fixture"><div class="fixture-team"><img src={asset(club.logo)} alt="関西ユナイテッドFC" width="60" height="60" /><span>関西ユナイテッドFC</span></div><span class="versus display">VS</span><div class="fixture-team"><span class="opponent-placeholder" aria-hidden="true">?</span><span>対戦相手 未発表</span></div></div>
      <div class="fixture-bottom"><p><Icon name="calendar" size={16} /> 日時 未発表 <span class="fixture-divider"></span><Icon name="pin" size={16} /> 会場 未発表</p><details class="fixture-details"><summary>試合情報を見る <Icon name="arrow" size={17} /></summary><p>試合日程・大会・会場は、正式に発表された情報を掲載します。</p></details></div>
    </div>
    <div class="match-panel result-panel" id="result-panel" role="tabpanel" aria-labelledby="result-tab" hidden><div class="match-panel-top"><span class="eyebrow">LATEST RESULT</span><span class="pending-tag">掲載準備中</span></div><div class="empty-result"><Icon name="ball" size={42} /><h3>試合結果は、公開をお待ちください。</h3><p>公式の試合結果が確認でき次第、こちらに掲載します。</p></div></div>
  </section>

  <section class="shell news-section section-anchor" id="news" aria-labelledby="news-title" data-filter-group>
    <div class="section-heading"><div><p class="eyebrow">ニュース & ストーリー</p><h2 id="news-title" class="display">LATEST NEWS<span class="text-blue">.</span></h2></div><a class="text-link" href={page('news/')}>すべてのニュース <Icon name="arrow" /></a></div>
    <div class="news-filters" aria-label="ニュースのカテゴリ"><button type="button" data-filter="all" aria-pressed="true">すべて</button><button type="button" data-filter="training" aria-pressed="false">トレーニング</button><button type="button" data-filter="club" aria-pressed="false">クラブ</button><span data-news-count aria-live="polite">3 STORIES</span></div>
    <div class="news-grid">
      {stories.map((story, index) => <article class="news-card" data-category={story.category}>
        <a href={page(`news/${story.id}/`)}><div class="news-card-image"><Photo src={index === 0 ? story.gallery[1]! : story.image} alt={story.alt} /><span class="image-category">{story.category === 'training' ? 'TRAINING' : 'CLUB'}</span></div><div class="news-card-copy"><p class="news-meta"><time datetime={story.published.replaceAll('.', '-')}>{story.published}</time><span> / {story.category === 'training' ? 'トレーニング' : 'クラブ情報'}</span></p><h3>{story.title}</h3><p class="card-summary">{story.summary}</p><span class="card-read">記事を読む <Icon name="arrow" size={19} /></span></div></a>
      </article>)}
    </div>
    <p class="source-note">公式Instagramの投稿をもとに編集しています。各記事から原文をご覧いただけます。</p>
  </section>

  <section class="team-section section-anchor" id="team" aria-labelledby="team-title">
    <div class="shell team-inner">
      <div class="team-copy"><p class="eyebrow">選手・スタッフ</p><h2 id="team-title" class="display">OUR<br />UNITED<span>.</span></h2><p>ピッチでプレーする人。<br />チームを支える人。</p><p class="team-note">選手・スタッフのプロフィールは、<br />公式情報を確認してからご紹介します。</p><span class="team-status"><span class="status-dot"></span> プロフィール掲載準備中</span></div>
      <div class="player-previews" aria-label="選手プロフィールの掲載予定エリア">
        {['GOALKEEPER', 'DEFENDER', 'MIDFIELDER', 'FORWARD'].map((position, index) => <div class="player-placeholder"><span class="player-position">{position}</span><span class="player-line"></span><svg viewBox="0 0 200 230" fill="none" aria-hidden="true"><circle cx="100" cy="75" r="34" /><path d="M22 230v-26c0-44 35-70 78-70s78 26 78 70v26Z" /></svg><div class="player-caption"><span class="display">COMING<br />SOON<span class="text-blue">.</span></span><small>{['GK', 'DF', 'MF', 'FW'][index]} / 選手情報は準備中</small></div></div>)}
      </div>
    </div>
  </section>

  <section class="media-section section-anchor" id="media" aria-labelledby="media-title" data-tabs>
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">写真で見る、チームの今</p><h2 id="media-title" class="display">UNITED MEDIA<span class="text-blue">.</span></h2></div><a class="text-link" href={club.instagram} target="_blank" rel="noopener noreferrer">公式Instagram <Icon name="external" size={17} /></a></div>
      <div class="media-tabs" role="tablist" aria-label="メディアの種類"><button type="button" role="tab" id="photo-tab" aria-selected="true" aria-controls="photo-panel" tabindex="0"><Icon name="photo" size={17} /> フォト</button><button type="button" role="tab" id="video-tab" aria-selected="false" aria-controls="video-panel" tabindex="-1"><Icon name="play" size={17} /> 動画</button></div>
      <div class="media-grid" id="photo-panel" role="tabpanel" aria-labelledby="photo-tab">
        {gallery.map((photo, index) => <button class="media-photo" type="button" data-lightbox data-image={asset(photo.image)} data-caption={photo.label} data-source={photo.source} data-alt={photo.alt} aria-label={`${photo.alt}。写真を拡大`}><div class="media-image"><Photo src={photo.image} alt={photo.alt} /><span class="media-expand"><Icon name="external" size={17} /></span></div><span class="media-caption"><span><small>PHOTO {String(index + 1).padStart(2, '0')}</small><strong>{photo.label}</strong></span><Icon name="photo" size={18} /></span></button>)}
      </div>
      <div class="video-empty" id="video-panel" role="tabpanel" aria-labelledby="video-tab" hidden><span class="video-circle"><Icon name="play" size={34} /></span><p class="eyebrow">UNITED VIDEO</p><h3>動画は、公開準備中です。</h3><p>公式動画が公開されたら、こちらでご紹介します。</p></div>
      <p class="source-note media-credit">PHOTO CREDIT / @kansai_united_fc <span>写真をクリックすると拡大表示します。</span></p>
    </div>
  </section>

  <section class="shell club-join-section section-anchor" aria-label="クラブ紹介と参加について">
    <div class="club-panel section-anchor" id="club"><p class="eyebrow">クラブについて</p><h2 class="display">THIS IS<br />KANSAI UNITED<span class="text-blue">.</span></h2><div class="club-intro"><img src={asset(club.logo)} alt="関西ユナイテッドFC ロゴ" width="70" height="70" /><div><h3>関西ユナイテッドFC</h3><p>トレーニングの様子や参加に関する情報を、<br class="desktop-break" />公式Instagramで発信しています。</p></div></div><details class="club-details"><summary>クラブについてもっと知る <Icon name="arrow" size={18} /></summary><p>公式Instagramでは、服部緑地公園での練習風景を紹介しています。選手・スタッフ、活動方針などの詳しいプロフィールは掲載準備中です。</p><a href={club.instagram} target="_blank" rel="noopener noreferrer">公式Instagramを見る <Icon name="external" size={14} /></a></details></div>
    <div class="join-panel section-anchor" id="join"><span class="join-decoration" aria-hidden="true">+</span><p class="eyebrow">JOIN THE TEAM</p><h2>チームへの参加を<br />お考えの方へ。</h2><p class="join-roles">PLAYER <span>/</span> COACH <span>/</span> STAFF</p><p class="join-body">プレーする、教える、運営を支える。<br />参加や見学のご相談は、公式InstagramのDMへ。</p><a class="join-button" href={club.instagram} target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} /> 参加・見学について相談する <Icon name="arrow" size={20} /></a><p class="join-note">初参加はご連絡順にご案内しています。<br />現在の受付状況や参加条件は、DMでご確認ください。</p></div>
  </section>
</SiteLayout>
