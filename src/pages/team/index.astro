---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import { loadPublicContent } from "../../data/cms";
import { club } from "../../data/club";
import { positions } from "../../lib/content-types";
const { players } = await loadPublicContent();
const active = players.filter((p) => p.activityStatus === "active");
const others = players.filter((p) => p.activityStatus !== "active");
---

<SiteLayout title={"選手・スタッフ | " + club.name}>
  <PageHero
    title="OUR SQUAD"
    japanese="選手・スタッフ"
    description="ピッチでプレーする人。チームを支える人。チームの仲間たちをご紹介します。"
  />
  <div class="shell subpage-content">
    <nav class="position-nav" aria-label="ポジション">
      {positions.map((p) => (
        <a href={"#" + p.id}>
          <strong>{p.id}</strong>
          <span>{p.japanese}</span>
        </a>
      ))}
    </nav>
    {positions.map((position) => {
      const group = active.filter((p) => p.position === position.id);
      return (
        <section class="roster-group section-anchor" id={position.id}>
          <div class="roster-heading">
            <h2 class="display">
              {position.english}
              <span class="text-blue">.</span>
            </h2>
            <span>{position.japanese}</span>
          </div>
          {group.length ? (
            <div class="squad-grid">
              {group.map((player) => (
                <PlayerCard player={player} />
              ))}
            </div>
          ) : (
            <div class="roster-empty">
              <span class="display">{position.id}</span>
              <div>
                <h3>プロフィール掲載準備中</h3>
                <p>選手プロフィールは、正式公開をお待ちください。</p>
              </div>
            </div>
          )}
        </section>
      );
    })}
    {others.length > 0 && (
      <section class="roster-group">
        <h2 class="display subsection-title">
          UNITED MEMBERS<span class="text-blue">.</span>
        </h2>
        <p>現在は活動を休止しているメンバー・以前在籍したメンバー</p>
        <div class="squad-grid">
          {others.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>
