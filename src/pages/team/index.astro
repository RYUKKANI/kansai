---
import { forLocale, localeFromUrl } from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
import { clubForLocale } from "../../data/locales/content";
const club = clubForLocale(locale);
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import PlayerCard from "../../components/PlayerCard.astro";
import { loadPublicContent } from "../../data/cms";

import { positions } from "../../lib/content-types";
const { players } = await loadPublicContent(locale);
const active = players.filter((p) => p.activityStatus === "active");
const others = players.filter((p) => p.activityStatus !== "active");
---

<SiteLayout title={t("選手・スタッフ | ") + club.name}>
  <PageHero
    title="OUR SQUAD"
    japanese={t("選手・スタッフ")}
    description={t(
      "ピッチでプレーする人。チームを支える人。チームの仲間たちをご紹介します。",
    )}
  />
  <div class="shell subpage-content">
    <nav class="position-nav" aria-label={t("ポジション")}>
      {positions.map((p) => (
        <a href={"#" + p.id}>
          <strong>{p.id}</strong>
          <span>{t(p.japanese)}</span>
        </a>
      ))}
    </nav>
    {positions.map((position) => {
      const group = active.filter((p) => p.position === position.id);
      return (
        <section class="roster-group section-anchor" id={position.id}>
          <div class="roster-heading">
            <h2 class="display">
              {position.english}
              <span class="text-blue">.</span>
            </h2>
            <span>{t(position.japanese)}</span>
          </div>
          {group.length ? (
            <div class="squad-grid">
              {group.map((player) => (
                <PlayerCard player={player} />
              ))}
            </div>
          ) : (
            <div class="roster-empty">
              <span class="display">{position.id}</span>
              <div>
                <h3>{t("プロフィール掲載準備中")}</h3>
                <p>{t("選手プロフィールは、正式公開をお待ちください。")}</p>
              </div>
            </div>
          )}
        </section>
      );
    })}
    {others.length > 0 && (
      <section class="roster-group">
        <h2 class="display subsection-title">
          UNITED MEMBERS<span class="text-blue">.</span>
        </h2>
        <p>{t("現在は活動を休止しているメンバー・以前在籍したメンバー")}</p>
        <div class="squad-grid">
          {others.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>
      </section>
    )}
  </div>
</SiteLayout>
