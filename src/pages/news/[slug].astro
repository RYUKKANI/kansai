---
import {
  forLocale,
  localeFromUrl,
  formatForLocale,
  localizedPage,
} from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
import { clubForLocale } from "../../data/locales/content";
const club = clubForLocale(locale);
const format = formatForLocale(locale);
const page = (path = "") => localizedPage(path, locale);
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/Icon.astro";
import Photo from "../../components/Photo.astro";
import { storyCategories, type Story } from "../../data/club";
import { loadPublicContent } from "../../data/cms";
import { asset } from "../../lib/urls";

// 기사 id마다 정적 상세 페이지를 만듭니다. 새 기사는 data/club.ts의 stories에 등록합니다.
export async function getStaticPaths() {
  const { stories } = await loadPublicContent();
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}
interface Props {
  story: Story;
}
const { story } = Astro.props;
---

<SiteLayout title={`${story.title} | ${club.name}`} description={story.summary}>
  <article class="shell story-page">
    <nav class="breadcrumbs" aria-label={t("パンくず")}>
      <a href={page()}>{t("HOME")}</a>
      <Icon name="chevron" size={13} />
      <a href={page("news/")}>NEWS</a>
      <Icon name="chevron" size={13} />
      <span>{t(storyCategories[story.category].badge)}</span>
    </nav>
    <div class="story-page-heading">
      <p class="eyebrow">
        {story.label} <span>/</span> {story.published}
      </p>
      <h1>{story.title}</h1>
      <p>{story.summary}</p>
    </div>
    <Photo src={story.image} alt={story.alt} class="article-hero" priority />

    <!-- 활동일과 본문 문단은 기사 데이터에서 가져옵니다. 출처 링크는 항상 함께 표시합니다. -->
    <div class="article-body">
      <p class="article-credit">
        {format("写真：{0} 公式Instagram", club.name)}
      </p>
      {story.activityDate && (
        <p class="activity-date">
          <Icon name="calendar" size={17} />
          {format("活動日：{0}", story.activityDate)}
        </p>
      )}
      {story.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      {story.source && (
        <a
          class="source-button"
          href={story.source}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="external" size={21} />
          {t("関連する公式情報")} <Icon name="external" size={17} />
        </a>
      )}
    </div>

    <!-- 사진이 두 장 이상인 기사에만 갤러리를 표시합니다. 클릭하면 공통 사진 대화상자가 열립니다. -->
    {story.gallery.length > 1 && (
      <section class="article-gallery" aria-labelledby="gallery-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{t("トレーニングの風景")}</p>
            <h2 class="display" id="gallery-title">
              IN PICTURES<span class="text-blue">.</span>
            </h2>
          </div>
        </div>
        <div class="article-gallery-grid">
          {story.gallery.map((image, index) => (
            <button
              type="button"
              class="gallery-button"
              data-lightbox
              data-image={asset(image)}
              data-natural={!image.startsWith("assets/training-")}
              data-alt={story.alt}
              data-caption={`${story.activityDate ?? ""} / PHOTO ${index + 1}`}
              data-source={story.source}
              aria-label={format("活動写真 {0} を拡大", index + 1)}
            >
              <Photo
                src={image}
                alt={format("{0}（写真 {1}）", story.alt, index + 1)}
              />
              <span class="media-expand">
                <Icon name="external" size={18} />
              </span>
            </button>
          ))}
        </div>
      </section>
    )}
    <a class="back-link" href={page("news/")}>
      <span>←</span>
      {t("ニュース一覧へ戻る")}
    </a>
  </article>
</SiteLayout>
