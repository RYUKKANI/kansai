---
import {
  forLocale,
  localeFromUrl,
  formatForLocale,
  localizedPage,
} from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
import { clubForLocale } from "../../data/locales/content";
const club = clubForLocale(locale);
const format = formatForLocale(locale);
const page = (path = "") => localizedPage(path, locale);
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/Icon.astro";
import NewsCard from "../../components/NewsCard.astro";
import NewsFilters from "../../components/NewsFilters.astro";

import { loadPublicContent } from "../../data/cms";

// 목록의 기사·분류는 data/club.ts에서 편집합니다. 홈과 공통 카드·필터를 사용합니다.
const { stories } = await loadPublicContent(locale);
---

<SiteLayout title={format("ニュース | {0}", club.name)}>
  <section class="shell news-archive" data-filter-group>
    <nav class="breadcrumbs" aria-label={t("パンくず")}>
      <a href={page()}>{t("HOME")}</a>
      <Icon name="chevron" size={13} />
      <span>NEWS</span>
    </nav>
    <p class="eyebrow">
      {club.name}
      {t("のニュース")}
    </p>
    <h1 class="display archive-title">
      NEWS & STORIES<span class="text-blue">.</span>
    </h1>
    <p class="archive-intro">
      {t("トレーニングの様子から、クラブのお知らせまで。")}
    </p>
    <NewsFilters total={stories.length} />
    <div class="news-grid">
      {stories.map((story) => (
        <NewsCard story={story} headingLevel={2} />
      ))}
    </div>
    {stories.length === 0 && (
      <p class="content-empty">{t("ニュースは、公開をお待ちください。")}</p>
    )}
  </section>
</SiteLayout>
