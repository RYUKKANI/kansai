---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Photo from "../../components/Photo.astro";
import Icon from "../../components/Icon.astro";
import { loadPublicContent } from "../../data/cms";
import { club } from "../../data/club";
import { asset, page } from "../../lib/urls";
const { pages } = await loadPublicContent();
const content = pages.find((p) => p.id === "club");
---

<SiteLayout title={"クラブについて | " + club.name}>
  <PageHero
    title="THIS IS UNITED"
    japanese="クラブについて"
    description={content?.introduction ?? "クラブ情報は、公開準備中です。"}
  />
  <div class="shell subpage-content">
    <div class="club-page-layout">
      <div class="club-page-copy">
        <img
          src={asset(club.logo)}
          alt={club.name + " ロゴ"}
          width="100"
          height="100"
        />
        <p class="eyebrow">KANSAI UNITED FC</p>
        <h2>{content?.title ?? club.name}</h2>
        {content?.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <a
          class="text-link"
          href={club.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          公式Instagram <Icon name="external" size={16} />
        </a>
      </div>
      <Photo
        src="assets/training-october-01.jpg"
        alt="青空の下でトレーニングする関西ユナイテッドFC"
        class="club-page-photo"
      />
    </div>
    <div class="club-route-grid">
      {[
        { path: "team/", title: "TEAM", copy: "選手プロフィール" },
        { path: "matches/", title: "MATCHES", copy: "試合日程・結果" },
        { path: "join/", title: "JOIN US", copy: "参加・見学について" },
      ].map((item) => (
        <a href={page(item.path)}>
          <span class="display">{item.title}</span>
          <strong>{item.copy}</strong>
          <Icon name="arrow" />
        </a>
      ))}
    </div>
  </div>
</SiteLayout>
