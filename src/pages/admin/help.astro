---
import { club } from "../../data/club";
import { asset } from "../../lib/urls";
import { localeFromUrl, localizedPage } from "../../lib/i18n";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import StaffSupportRecovery from "../../components/StaffSupportRecovery.astro";
import SecurityHead from "../../components/SecurityHead.astro";
import "../../styles/admin-base.css";
import "../../styles/admin.css";
import "../../styles/languages.css";
import "../../styles/staff-auth.css";
const locale = localeFromUrl(Astro.url);
const page = (path = "") => localizedPage(path, locale);
const enabled = import.meta.env.PUBLIC_STAFF_IDENTITY_ENABLED === "true";
// 관리자 작업 스크립트를 실행하지 않는 전용 복구 화면입니다. 인증 토큰을 다른 URL에 복사하지 않습니다.
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <SecurityHead office />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0B2447" />
    <title>KANSAI UNITED FC — CLUB OFFICE HELP</title>
  </head>
  <body class="admin-body staff-auth-help-layout staff-identity-auth">
    <a class="skip-link" href="#help-main"><span data-i18n="ログインのヘルプ">ログインのヘルプ</span></a>
    <header class="admin-header">
      <a href={page("admin/")} class="admin-brand"><img src={asset(club.logo)} alt="" width="44" height="44" /><span><strong>KANSAI UNITED FC</strong><small>CLUB OFFICE</small></span></a>
      <LanguageSwitcher />
    </header>
    <main id="help-main">
      <section class="staff-auth-portal" id="staff-auth-help" data-enabled={String(enabled)} aria-labelledby="help-heading">
        <div class="staff-auth-card">
          <div class="staff-auth-brand">
            <img src={asset(club.logo)} width="72" height="72" alt="KANSAI UNITED FC" />
            <p class="eyebrow">CLUB OFFICE</p>
            <h1 id="help-heading"><span data-i18n="ログインのヘルプ">ログインのヘルプ</span></h1>
          </div>
          <div id="staff-help-message" class="staff-auth-message" role="status" aria-live="polite" tabindex="-1"></div>
          <p id="staff-help-unavailable" class="admin-help" hidden={enabled}><span data-i18n="このログイン機能は現在利用できません。ログイン画面に戻るか、最高管理者にご相談ください。">このログイン機能は現在利用できません。ログイン画面に戻るか、最高管理者にご相談ください。</span></p>
          <div id="staff-help-options" hidden={!enabled}>
            <h2><span data-i18n="ログインできない場合">ログインできない場合</span></h2>
            <p class="admin-help"><span data-i18n="ログインIDが不明な場合やパスワードを忘れた場合は、最高管理者にご相談ください。本人と既存アカウントを確認し、管理画面から対応します。">ログインIDが不明な場合やパスワードを忘れた場合は、最高管理者にご相談ください。本人と既存アカウントを確認し、管理画面から対応します。</span></p>
            <StaffSupportRecovery />
          </div>
          <div id="staff-new-password-panel" hidden>
            <h2 tabindex="-1"><span data-i18n="新しいパスワードを設定">新しいパスワードを設定</span></h2>
            <form id="staff-new-password-form">
              <label for="staff-new-password"><span data-i18n="パスワード">パスワード</span></label>
              <div class="staff-password-field"><input id="staff-new-password" placeholder="パスワード" data-i18n-placeholder="パスワード" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="72" aria-describedby="staff-new-password-help" /><button type="button" data-password-toggle="staff-new-password" aria-controls="staff-new-password" aria-pressed="false"><span data-i18n="表示">表示</span></button></div>
              <p id="staff-new-password-help" class="admin-help"><span data-i18n="パスワードは12文字以上、UTF-8で72バイト以内にしてください。">パスワードは12文字以上、UTF-8で72バイト以内にしてください。</span></p>
              <label for="staff-new-password-confirm"><span data-i18n="パスワードの確認">パスワードの確認</span></label>
              <div class="staff-password-field"><input id="staff-new-password-confirm" placeholder="パスワードの確認" data-i18n-placeholder="パスワードの確認" name="password_confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="72" /><button type="button" data-password-toggle="staff-new-password-confirm" aria-controls="staff-new-password-confirm" aria-pressed="false"><span data-i18n="表示">表示</span></button></div>
              <button type="submit" class="admin-primary"><span data-i18n="パスワードを保存">パスワードを保存</span></button>
            </form>
          </div>
          <p class="admin-help"><span data-i18n="復旧の申請だけではパスワードや権限は変更されません。本人確認と管理者の承認が必要です。">復旧の申請だけではパスワードや権限は変更されません。本人確認と管理者の承認が必要です。</span></p>
        </div>
        <footer class="staff-auth-footer"><a href={page("admin/")} class="staff-auth-help"><span data-i18n="ログインに戻る">ログインに戻る</span></a></footer>
      </section>
    </main>
    <script src="../../scripts/staff-auth-help.ts"></script>
  </body>
</html>
