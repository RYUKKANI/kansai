---
// data-i18n 문구는 로그인 세션을 읽기 전에 선택 언어로 표시합니다. 입력된 콘텐츠는 번역하지 않습니다.
import AdminLayout from "../../layouts/AdminLayout.astro";
import StaffAuthPortal from "../../components/admin/StaffAuthPortal.astro";
import "../../styles/admin-staff.css";
// 운영 Owner의 실제 전환 검증이 끝날 때까지 기존 로그인 화면을 유지합니다.
const staffIdentityEnabled = import.meta.env.PUBLIC_STAFF_IDENTITY_ENABLED === "true";
// 양식·목록은 브라우저에서 확인한 세션과 DB 역할에 따라 구성합니다. 실제 접근 권한은 RLS가 결정합니다.
---

<AdminLayout>
  <div
    id="admin-notice"
    class="admin-notice"
    role="status"
    aria-live="polite"
  ></div>
  {staffIdentityEnabled ? <div id="login-panel"><StaffAuthPortal /></div> : (
  <section class="admin-login" id="login-panel">
    <p class="eyebrow">CLUB OFFICE</p>
    <h1>
      <span data-i18n="運営メンバーのログイン">運営メンバーのログイン</span>
    </h1>
    <p>
      <span data-i18n="招待されたメールアドレスでログインしてください。">
        招待されたメールアドレスでログインしてください。
      </span>
    </p>
    <!-- 초대만 받은 계정에는 아직 비밀번호가 없습니다. 첫 인증과 이후 로그인을 구분해 안내합니다. -->
    <p class="admin-help">
      <span data-i18n="初回は招待メールの確認リンクを開いてください。メールが見つからない・期限切れの場合は、下のメールリンク送信をお試しください。">
        初回は招待メールの確認リンクを開いてください。メールが見つからない・期限切れの場合は、下のメールリンク送信をお試しください。
      </span>
    </p>
    <form id="login-form">
      <label>
        <span data-i18n="メールアドレス">メールアドレス</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
      <label>
        <span data-i18n="パスワード">パスワード</span>
        <input
          type="password"
          name="password"
          autocomplete="current-password"
        />
      </label>
      <button type="submit" class="admin-primary">
        <span data-i18n="ログイン">ログイン</span>
      </button>
      <button type="button" id="magic-link-button" class="admin-secondary">
        <span data-i18n="メールのログインリンクを送信">
          メールのログインリンクを送信
        </span>
      </button>
      <p class="admin-help">
        <span data-i18n="メールリンクではパスワードを入力する必要はありません。新規登録は受け付けていません。">
          メールリンクではパスワードを入力する必要はありません。新規登録は受け付けていません。
        </span>
      </p>
    </form>
    <p id="config-warning" class="admin-help" hidden>
      <span data-i18n="管理システムの接続は準備中です。">
        管理システムの接続は準備中です。
      </span>
    </p>
  </section>
  )}
  <div class="admin-workspace" id="workspace" hidden>
    <div id="sidebar-backdrop" class="office-sidebar-backdrop" hidden></div>
    <aside
      class="admin-sidebar"
      id="admin-sidebar"
      aria-label="クラブ運営メニュー"
      data-i18n-aria-label="クラブ運営メニュー"
    >
      <div class="office-sidebar-heading">
        <div>
          <strong>CLUB OFFICE</strong>
          <span>
            <span data-i18n="クラブ運営管理">クラブ運営管理</span>
          </span>
        </div>
        <button
          type="button"
          id="sidebar-close"
          class="office-icon-button"
          aria-label="管理メニューを閉じる"
          data-i18n-aria-label="管理メニューを閉じる"
        >
          ✕
        </button>
      </div>
      <button
        type="button"
        id="sidebar-collapse"
        class="office-collapse"
        aria-label="サイドバーを折りたたむ"
        data-i18n-aria-label="サイドバーを折りたたむ"
        aria-expanded="true"
      ></button>
      <nav
        id="admin-navigation"
        aria-label="管理メニュー"
        data-i18n-aria-label="管理メニュー"
      ></nav>
      <div class="office-sidebar-footer">
        <span class="office-sidebar-caption">KANSAI UNITED FC</span>
        <button type="button" id="logout-button" class="admin-secondary">
          <span data-i18n="ログアウト">ログアウト</span>
        </button>
      </div>
    </aside>
    <div class="admin-main-panel">
      <div class="admin-page-heading">
        <div>
          <p class="eyebrow" id="page-eyebrow">
            OVERVIEW / DASHBOARD
          </p>
          <h1 id="resource-title" tabindex="-1">
            <span data-i18n="ダッシュボード">ダッシュボード</span>
          </h1>
          <p class="office-page-description" id="page-description"></p>
        </div>
        <button type="button" id="new-button" class="admin-primary" hidden>
          <span data-i18n="新規登録">新規登録</span>
        </button>
      </div>
      <div id="publication-status" class="publication-status"></div>
      <div id="admin-content"></div>
    </div>
  </div>
  <dialog
    id="editor-dialog"
    class="admin-dialog"
    aria-labelledby="editor-title"
  >
    <div class="admin-dialog-heading">
      <h2 id="editor-title">
        <span data-i18n="編集">編集</span>
      </h2>
      <button
        type="button"
        id="editor-close"
        aria-label="編集画面を閉じる"
        data-i18n-aria-label="編集画面を閉じる"
      >
        ✕
      </button>
    </div>
    <div id="editor-notice" role="alert" class="office-editor-notice"></div>
    <form id="editor-form">
      <div class="office-editor-layout">
        <div id="editor-fields" class="admin-form-grid"></div>
        <aside class="office-editor-sidebar">
          <div id="editor-meta"></div>
          <div class="admin-editor-actions" id="editor-actions"></div>
          <div id="editor-preview-actions"></div>
          <div id="editor-content-tools"></div>
        </aside>
      </div>
    </form>
  </dialog>
  <dialog
    id="unsaved-dialog"
    class="admin-dialog admin-confirm"
    aria-labelledby="unsaved-title"
  >
    <h2 id="unsaved-title">
      <span data-i18n="編集内容が保存されていません">
        編集内容が保存されていません
      </span>
    </h2>
    <p>
      <span data-i18n="変更を破棄して編集画面を閉じますか？">
        変更を破棄して編集画面を閉じますか？
      </span>
    </p>
    <div class="admin-editor-actions">
      <button type="button" id="unsaved-continue" class="admin-secondary">
        <span data-i18n="編集を続ける">編集を続ける</span>
      </button>
      <button type="button" id="unsaved-discard" class="admin-danger">
        <span data-i18n="変更を破棄する">変更を破棄する</span>
      </button>
    </div>
  </dialog>
  <dialog
    id="article-preview-dialog"
    class="admin-dialog office-preview-dialog"
    aria-labelledby="preview-title"
  >
    <div class="admin-dialog-heading">
      <div>
        <p class="office-kicker">NEWS PREVIEW</p>
        <h2 id="preview-title">
          <span data-i18n="公開前プレビュー">公開前プレビュー</span>
        </h2>
      </div>
      <button
        type="button"
        id="preview-close"
        aria-label="プレビューを閉じる"
        data-i18n-aria-label="プレビューを閉じる"
      >
        ✕
      </button>
    </div>
    <p class="admin-help">
      <span data-i18n="編集中の内容を確認する画面です。保存・発行はまだ行われていません。">
        編集中の内容を確認する画面です。保存・発行はまだ行われていません。
      </span>
    </p>
    <div id="article-preview-content"></div>
  </dialog>
  <dialog
    id="delete-dialog"
    class="admin-dialog admin-confirm"
    aria-labelledby="delete-title"
  >
    <h2 id="delete-title">
      <span data-i18n="削除の確認">削除の確認</span>
    </h2>
    <p id="delete-description"></p>
    <p>
      <span data-i18n="この操作は取り消せません。必要な記事や写真を確認してください。">
        この操作は取り消せません。必要な記事や写真を確認してください。
      </span>
    </p>
    <div class="admin-editor-actions">
      <button type="button" id="delete-cancel" class="admin-secondary">
        <span data-i18n="キャンセル">キャンセル</span>
      </button>
      <button type="button" id="delete-confirm" class="admin-danger">
        <span data-i18n="削除する">削除する</span>
      </button>
    </div>
  </dialog>
  <dialog
    id="invite-dialog"
    class="admin-dialog admin-confirm"
    aria-labelledby="invite-title"
  >
    <h2 id="invite-title">
      <span data-i18n="運営メンバーを招待">運営メンバーを招待</span>
    </h2>
    <form id="invite-form">
      <label>
        <span data-i18n="メールアドレス">メールアドレス</span>
        <input type="email" name="email" required />
      </label>
      <label>
        <span data-i18n="権限">権限</span>
        <select name="role">
          <option value="administrator">Administrator</option>
          <option value="editor">Editor</option>
          <option value="coach">Coach</option>
          <option value="owner">Owner</option>
        </select>
      </label>
      <div class="admin-editor-actions">
        <button type="button" id="invite-cancel" class="admin-secondary">
          <span data-i18n="キャンセル">キャンセル</span>
        </button>
        <button type="submit" class="admin-primary">
          <span data-i18n="招待メールを送信">招待メールを送信</span>
        </button>
      </div>
    </form>
  </dialog>
  <noscript>
    <p class="content-empty">
      <span data-i18n="管理画面を利用するにはJavaScriptを有効にしてください。">
        管理画面を利用するにはJavaScriptを有効にしてください。
      </span>
    </p>
  </noscript>
</AdminLayout>
