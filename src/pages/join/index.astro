---
import { forLocale, localeFromUrl } from "../../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
const t = forLocale(locale);
import { clubForLocale } from "../../data/locales/content";
const club = clubForLocale(locale);
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { loadPublicContent } from "../../data/cms";

const { pages } = await loadPublicContent(locale);
const content = pages.find((p) => p.id === "join");
// 실제 참가 조건과 비용은 확인된 공식 안내만 기재합니다. 개인정보 입력 폼은 만들지 않습니다.
---

<SiteLayout title={t("チームへの参加 | ") + club.name}>
  <PageHero
    title="JOIN UNITED"
    japanese={t("チームへの参加")}
    description={
      content?.introduction ?? t("お問い合わせは公式InstagramのDMへ。")
    }
  />
  <div class="shell subpage-content join-page">
    <div class="join-page-heading">
      <p class="eyebrow">PLAYER / COACH / STAFF</p>
      <h2>{content?.title ?? t("チームへの参加について")}</h2>
      {content?.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <div class="join-role-grid">
      {[
        { title: "PLAYER", text: t("選手としてチームに参加したい方") },
        { title: "COACH", text: t("指導者として活動に関わりたい方") },
        { title: "STAFF", text: t("運営を支えてくださる方") },
      ].map((role) => (
        <div>
          <span class="display">{role.title}</span>
          <p>{role.text}</p>
        </div>
      ))}
    </div>
    <div class="join-contact">
      <p class="eyebrow">LET’S TALK</p>
      <h2>{t("最初の一歩は、DMから。")}</h2>
      <p>{t("参加や見学の希望を、公式アカウントにお送りください。")}</p>
      <a href={club.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size={22} />
        {t("公式Instagramで相談する")} <Icon name="arrow" size={22} />
      </a>
    </div>
  </div>
</SiteLayout>
