---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import PhotoDialog from '../components/PhotoDialog.astro';
import { club } from '../data/club';
import { asset } from '../lib/urls';
import '../styles/global.css';
// 모든 페이지의 공통 틀입니다. 페이지별 제목·설명만 Props로 전달합니다.
interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${club.name} | ${club.englishName}`,
  description = club.description,
} = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- 디자인 확인용 사이트입니다. 정식 공개를 결정한 단계에서 검색 노출 설정을 검토합니다. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1168BC" />
    <title>{title}</title>
    <link rel="icon" href={asset(club.logo)} type="image/jpeg" />
  </head>
  <body>
    <a class="skip-link" href="#main">メインコンテンツへ移動</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <!-- 대화상자의 화면과 동작을 분리하여 각각 편집하기 쉽게 유지합니다. -->
    <SearchDialog />
    <PhotoDialog />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
