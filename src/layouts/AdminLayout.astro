---
import { localeFromUrl, localizedPage } from "../lib/i18n";
// 화면 언어는 URL에서 결정합니다. 일본어 원문과 저장 데이터는 유지합니다.
const locale = localeFromUrl(Astro.url);
import { clubForLocale } from "../data/locales/content";
const club = clubForLocale(locale);
const page = (path = "") => localizedPage(path, locale);
const staffIdentityEnabled = import.meta.env.PUBLIC_STAFF_IDENTITY_ENABLED === "true";

import { asset } from "../lib/urls";
import "../styles/global.css";
import "../styles/admin.css";
import "../styles/languages.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
// [편집 안내] 공개 메뉴와 분리한 관리자 전용 화면입니다. 로그인과 권한 검사 전에는 데이터를 표시하지 않습니다.
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#0B2447" />
    <title>KANSAI UNITED FC — CLUB OFFICE</title>
  </head>
  <!-- 어두운 인증 화면의 스타일은 기능 플래그가 켜진 미로그인 상태에만 적용합니다. -->
  <body class:list={["admin-body", { "staff-identity-auth": staffIdentityEnabled }]}>
    <a class="skip-link" href="#admin-main">
      <span data-i18n="管理画面へ移動">管理画面へ移動</span>
    </a>
    <header class="admin-header">
      <button
        id="sidebar-open"
        class="office-icon-button"
        type="button"
        aria-label="管理メニューを開く"
        data-i18n-aria-label="管理メニューを開く"
        aria-controls="admin-sidebar"
        aria-expanded="false"
        hidden
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <a href={page("admin/")} class="admin-brand">
        <img src={asset(club.logo)} alt="" width="44" height="44" />
        <span>
          <strong>KANSAI UNITED FC</strong>
          <small>CLUB OFFICE</small>
        </span>
      </a>
      <div id="office-breadcrumb" class="office-breadcrumb" hidden>
        <span>CLUB OFFICE</span>
        <span aria-hidden="true">/</span>
        <strong id="header-page-title">
          <span data-i18n="ダッシュボード">ダッシュボード</span>
        </strong>
      </div>
      <div id="header-account" class="office-header-account" hidden>
        <span id="account-avatar" class="office-avatar"></span>
        <div>
          <strong id="account-email"></strong>
          <span id="account-role"></span>
        </div>
      </div>
      <LanguageSwitcher />
      <a
        class="office-public-link"
        href={page()}
        target="_blank"
        rel="noopener"
      >
        <span data-i18n="公開サイトを見る ↗">公開サイトを見る ↗</span>
      </a>
    </header>
    <main id="admin-main">
      <slot />
    </main>
    <script src="../scripts/admin.ts"></script>
  </body>
</html>
